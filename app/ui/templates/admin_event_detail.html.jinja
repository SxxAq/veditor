{% extends "admin_base.html.jinja" %}

{% macro status_badge(status) %}
  {% if status == 'waiting_for_files' %}
    <span class="badge badge-waiting"><span class="badge-dot"></span>Waiting for files</span>
  {% elif status == 'detecting' %}
    <span class="badge badge-processing"><span class="spinner spinner-sm"></span>Detecting</span>
  {% elif status in ['pending_approval', 'pending_bounds'] %}
    <span class="badge badge-pending"><span class="badge-dot"></span>Pending Review</span>
  {% elif status in ['cutting', 'generating_previews', 'assembling', 'transcoding', 'uploading'] %}
    <span class="badge badge-processing"><span class="spinner spinner-sm"></span>{{ status | replace('_', ' ') | title }}</span>
  {% elif status == 'preview' %}
    <span class="badge badge-preview"><span class="badge-dot"></span>Preview Ready</span>
  {% elif status == 'needs_work' %}
    <span class="badge badge-pending"><span class="badge-dot"></span>Needs Work</span>
  {% elif status == 'done' %}
    <span class="badge badge-done"><span class="badge-dot"></span>Published</span>
  {% elif status in ['rejected', 'broken'] %}
    <span class="badge badge-danger"><span class="badge-dot"></span>{{ status | title }}</span>
  {% else %}
    <span class="badge badge-waiting"><span class="badge-dot"></span>{{ status }}</span>
  {% endif %}
{% endmacro %}

{% block title %}{{ event.name }} — Talks Detail — Admin Console{% endblock %}

{% block breadcrumb %}
  <a href="/admin">Admin Console</a>
  <span class="sep">/</span>
  <a href="/admin/events">Events</a>
  <span class="sep">/</span>
  <span class="current">{{ event.name }}</span>
{% endblock %}

{% block content %}
<div class="page-body">

  {% if status_msg == 'settings_saved' %}
  <div class="admin-alert alert-success" role="alert" style="margin-bottom: 20px; display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.3); border-radius: 8px; color: #16a34a;">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
      <polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
    <span>Event review settings saved successfully.</span>
  </div>
  {% endif %}

  <!-- Event Header Card -->
  <div class="event-detail-header">
    <div class="event-detail-info">
      <h1>{{ event.name }}</h1>
      <div class="event-detail-meta">
        <span>Event ID: <strong>#{{ event.id }}</strong></span>
        <span>&bull;</span>
        <span>
          Organizer: 
          {% if event.created_by_user %}
            <strong>{{ event.created_by_user.email }}</strong>
          {% elif event.created_by_user_id %}
            <strong>User #{{ event.created_by_user_id }}</strong>
          {% else %}
            <span class="text-muted">—</span>
          {% endif %}
        </span>
      </div>
    </div>
    <div class="event-progress-wrap">
      <progress class="event-progress-bar" value="{{ progress_pct }}" max="100"></progress>
      <span class="event-progress-pct">{{ progress_pct }}% Done</span>
    </div>
  </div>

  <!-- Event Settings & Overrides Card -->
  <div class="event-settings-card" style="background: var(--v-bg-card); border: 1px solid var(--v-border-subtle); border-radius: var(--v-radius-md); padding: 16px 24px; margin-bottom: 24px;">
    <form method="POST" action="/admin/events/{{ event.id }}/settings" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
      <div>
        <h3 style="font-size: 0.95rem; font-weight: 600; margin: 0 0 4px 0; color: var(--v-text-primary);">Speaker Review Window (Per-Event Override)</h3>
        <p style="font-size: 0.825rem; color: var(--v-text-secondary); margin: 0;">Configure how long review magic links remain valid for talks under this event.</p>
      </div>
      <div style="display: flex; align-items: center; gap: 12px;">
        <select name="speaker_magic_link_expire_hours" class="form-select form-select-sm" style="background: var(--v-bg-surface); color: var(--v-text-primary); border: 1px solid var(--v-border-subtle); border-radius: var(--v-radius-sm); padding: 7px 12px; font-size: 0.85rem;">
          <option value="" {% if event.speaker_magic_link_expire_hours is none %}selected{% endif %}>Default (Platform Setting: {{ global_speaker_magic_link_expire_hours }}h)</option>
          <option value="24" {% if event.speaker_magic_link_expire_hours == 24 %}selected{% endif %}>1 day (24 hours)</option>
          <option value="72" {% if event.speaker_magic_link_expire_hours == 72 %}selected{% endif %}>3 days (72 hours)</option>
          <option value="168" {% if event.speaker_magic_link_expire_hours == 168 %}selected{% endif %}>7 days (168 hours)</option>
          <option value="336" {% if event.speaker_magic_link_expire_hours == 336 %}selected{% endif %}>14 days (336 hours)</option>
          <option value="720" {% if event.speaker_magic_link_expire_hours == 720 %}selected{% endif %}>30 days (720 hours)</option>
        </select>
        <button type="submit" class="btn btn-primary btn-sm">Save</button>
      </div>
    </form>
  </div>

  <!-- Event Summary Stats Row -->
  <div class="stats-grid stats-grid-6">
    <div class="stat-card">
      <span class="stat-label">Total Talks</span>
      <span class="stat-value">{{ event_stats.total }}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Done</span>
      <span class="stat-value green">{{ event_stats.done }}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Processing</span>
      <span class="stat-value blue">{{ event_stats.processing }}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Pending</span>
      <span class="stat-value">{{ event_stats.pending }}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Preview Ready</span>
      <span class="stat-value blue">{{ event_stats.preview }}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Issues</span>
      <span class="stat-value {% if event_stats.broken > 0 %}red{% else %}green{% endif %}">{{ event_stats.broken }}</span>
    </div>
  </div>

  <!-- Talks Table -->
  <div class="table-wrap">
    <div class="table-header">
      <div>
        <span class="table-title">Talks in {{ event.name }}</span>
        <span class="table-count table-count-spaced">{{ talks | length }} talk{% if talks | length != 1 %}s{% endif %}</span>
      </div>
      <div class="table-header-actions">
        <a href="/admin/events" class="btn btn-ghost btn-sm">
          &larr; Back to Events
        </a>
      </div>
    </div>

    {% if talks %}
    <table>
      <thead>
        <tr>
          <th class="col-id">ID</th>
          <th>Talk Title</th>
          <th>Room</th>
          <th>Scheduled Start</th>
          <th>Duration</th>
          <th>Status</th>
          <th class="col-actions-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for talk in talks %}
        <tr>
          <td class="td-mono col-id">#{{ talk.id }}</td>
          <td class="td-title">
            <a href="/studio/talks/{{ talk.id }}?from=admin">
              <strong>{{ talk.title }}</strong>
            </a>
          </td>
          <td>{{ talk.room or '—' }}</td>
          <td class="td-mono">{{ talk.start.strftime('%b %d, %H:%M') if talk.start else '—' }}</td>
          <td class="td-mono">
            {% if talk.start and talk.end %}
              {% set dur = (talk.end - talk.start).total_seconds() | int %}
              {% set m = dur // 60 %}
              {% set s = dur % 60 %}
              {{ '%d:%02d' | format(m, s) }}
            {% else %}—{% endif %}
          </td>
          <td>
            {{ status_badge(talk.status) }}
          </td>
          <td class="col-actions-right">
            <a href="/studio/talks/{{ talk.id }}?from=admin" class="btn btn-ghost btn-sm" title="Open Studio Editor">
              Open in Studio
            </a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div class="events-empty-state">
      <p class="events-empty-title">No talks found</p>
      <p class="events-empty-desc">This event does not have any talks scheduled or imported yet.</p>
    </div>
    {% endif %}
  </div>

</div>
{% endblock %}
